{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/kare-at-home/",
      "destination": "/kare-at-home",
      "permanent": true
    },
    {
      "source": "/kare-at-home/about",
      "destination": "/kare-at-home#about-us",
      "permanent": true
    },
    {
      "source": "/kare-at-home/services",
      "destination": "/kare-at-home#services",
      "permanent": true
    },
    {
      "source": "/kare-at-home/contact",
      "destination": "/kare-at-home#contact",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://kareiq-api.onrender.com/app/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://kareiq-api.onrender.com/app/:path*",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://kareiq-api.onrender.com/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://kareiq-api.onrender.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/karenest",
      "destination": "https://karenest.co.in/",
      "permanent": false
    },
    {
      "source": "/karenest/:path*",
      "destination": "https://karenest.co.in/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://kareiq-api.onrender.com https://api.karenest.co.in; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://kareiq-api.onrender.com https://api.karenest.co.in; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}