# Copy this file to .env and fill in your values.

# Port the website runs on
PORT=3000

# Password for the admin page at /admin. Sign-in stays off until this is set.
# Restart the server after changing it.
ADMIN_PASSWORD=change-this-to-a-strong-password

# Set to true when hosting behind a proxy or load balancer (Render, Railway, Nginx...)
# so rate limiting sees the visitor's real IP.
TRUST_PROXY=false

# Address to listen on (0.0.0.0 = all network interfaces)
HOST=0.0.0.0

# Optional: email your team when a booking or enquiry arrives.
# Leave SMTP_HOST empty to turn email off. Gmail needs an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# Database for bookings, enquiries and admin edits (live site on Render).
# MongoDB Atlas: Database > Connect > Drivers > copy the connection string and put your
# database user's password in it. Leave empty on your own computer to use the data folder.
MONGODB_URI=
MONGODB_DB=kareiq

# On Render: send visitors who open the Render address straight to the real website.
SITE_URL=

# On Render: websites allowed to send forms to this server (comma-separated, with https://).
ALLOWED_ORIGINS=https://kareiq-website-full.vercel.app,https://karenest.co.in,https://www.karenest.co.in

# Optional (older setup): store bookings, enquiries and admin edits in Upstash Redis instead of
# the data folder. Required on Vercel (its servers can't keep files).
# On Vercel, adding "Upstash for Redis" under Storage fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: extra secret mixed into admin sign-in cookies. Changing it signs everyone out.
SESSION_SECRET=

# ---------- KareIQ app (/app): families, caregivers and the office sign in here ----------
# The first office login. Its password is ADMIN_PASSWORD (only used the very first time;
# after that, change it inside the app under "Your account").
ADMIN_EMAIL=admin@karenest.co.in
# Demo people and logins for trying the app on your own computer (password demo-pass-123).
# On by default when there is no database (data folder); never on with MongoDB unless set to true.
APP_DEMO=
# Signed out after this many minutes without activity, and after this many hours in total.
APP_IDLE_MINUTES=15
APP_MAX_HOURS=4
# Optional: the app's public address, used in welcome links (worked out automatically if empty),
# e.g. https://app.karenest.co.in/app
APP_URL=

# Optional: "Continue with Google / Facebook" (leave empty to keep them switched off)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# public address of this server, e.g. https://kareiq-api.onrender.com (callbacks: /api/app/auth/<provider>/callback)
OAUTH_REDIRECT_BASE=
