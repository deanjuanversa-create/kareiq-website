# Copy this file to .env and fill in your values.

# Which environment this is: production | staging | demo | development | test (docs/DEPLOYMENT.md).
# Empty on your computer = development. A hosted server without it counts as production, and a
# value that is not on this list is treated as production. Production and staging refuse to start
# without their database, with demo mode, or without SESSION_SECRET.
APP_ENV=

# Port the website runs on
PORT=3000

# The FIRST office admin's password (its login is ADMIN_EMAIL below), used only when no office
# admin exists yet. Office admins open /admin with their own app login; there is no shared admin
# password. ADMIN_SHARED_LOGIN=true brings the old shared sign-in back for local work only
# (never in production or staging).
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SHARED_LOGIN=

# Set to true when hosting behind a proxy or load balancer (Render, Railway, Nginx...)
# so rate limiting sees the visitor's real IP.
TRUST_PROXY=false
# How many proxies in front of the app append to X-Forwarded-For (1 on Render and Vercel). Only the
# entries they added are believed; anything a visitor sends to their left is ignored.
TRUST_PROXY_HOPS=1
# Strict-Transport-Security max-age in seconds, sent only on HTTPS requests (0 = off). Start at one
# day; raise to 31536000 once every address is confirmed on HTTPS. No includeSubDomains/preload.
HSTS_MAX_AGE=86400
# The same booking (every field identical) sent again within this many minutes is one booking.
BOOKING_DEDUP_MINUTES=10

# Address to listen on (0.0.0.0 = all network interfaces)
HOST=0.0.0.0

# Optional: email your team when a booking or enquiry arrives.
# Leave SMTP_HOST empty to turn email off. Gmail needs an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# Database for bookings, enquiries and admin edits (live site on Render).
# MongoDB Atlas: Database > Connect > Drivers > copy the connection string and put your
# database user's password in it. Leave empty on your own computer to use the data folder.
MONGODB_URI=
MONGODB_DB=kareiq

# On Render: send visitors who open the Render address straight to the real website.
SITE_URL=

# On Render: websites allowed to send forms to this server (comma-separated, with https://).
ALLOWED_ORIGINS=https://kareiq-website-full.vercel.app,https://karenest.co.in,https://www.karenest.co.in,https://karewellness.co.in

# Optional (older setup): store bookings, enquiries and admin edits in Upstash Redis instead of
# the data folder. Required on Vercel (its servers can't keep files).
# On Vercel, adding "Upstash for Redis" under Storage fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret for signed cookies (at least 16 characters). Required in production and staging.
SESSION_SECRET=

# ---------- KareIQ dashboard (/app): families, nurses and the office sign in here ----------
# The first office login. Its password is ADMIN_PASSWORD (only used the very first time;
# after that, change it inside the app under "Your account").
ADMIN_EMAIL=admin@karenest.co.in
# Demo people and logins (password demo-pass-123): only with APP_DEMO=true on your computer, or on
# a demo server (APP_ENV=demo). Never on by default, never in production or staging.
APP_DEMO=
# Production on a data folder instead of MongoDB (a VPS with a persistent disk) must be confirmed:
# FILE_STORAGE_CONFIRMED=true and DATA_DIR=/path/on/the/persistent/disk
FILE_STORAGE_CONFIRMED=
DATA_DIR=
# Signed out after this many minutes without activity, and after this many hours in total.
APP_IDLE_MINUTES=15
APP_MAX_HOURS=4
# Optional: the app's public address, used in welcome links (worked out automatically if empty),
# e.g. https://app.karenest.co.in/app
APP_URL=

# Optional: "Continue with Google / Facebook" (leave empty to keep them switched off)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# public address of this server, e.g. https://kareiq-api.onrender.com (callbacks: /api/app/auth/<provider>/callback)
OAUTH_REDIRECT_BASE=
