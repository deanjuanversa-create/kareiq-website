{
  "name": "kareiq-website",
  "version": "1.0.0",
  "private": true,
  "description": "KareIQ, Kare@Home, KareNest and KareWellness websites, the booking and enquiry API, and the KareIQ dashboard for families, nurses and the office",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:app": "node tools/check-app.js http://localhost:3000",
    "check:assess": "node tools/check-assess.js http://localhost:3000",
    "check:docs": "node tools/check-docs.js http://localhost:3000",
    "check:lifecycle": "node tools/check-lifecycle.js http://localhost:3000",
    "check:home": "node tools/check-home.js http://localhost:3000",
    "check:photos": "node tools/check-photos.js http://localhost:3000",
    "check:insights": "node tools/check-insights.js",
    "check:roles": "node tools/check-roles.js http://localhost:3000",
    "check:risk": "node tools/check-risk.js",
    "check:scheduler": "node tools/check-scheduler.js",
    "check:teams": "node tools/check-teams.js http://localhost:3000",
    "check:teams-ui": "python3 tools/check-teams-ui.py http://localhost:3000",
    "check:teams-more": "node tools/check-teams-more.js http://localhost:3000",
    "check:teams-more-ui": "python3 tools/check-teams-more-ui.py http://localhost:3000",
    "check:teams-growth": "node tools/check-teams-growth.js http://localhost:3000",
    "check:teams-growth-ui": "python3 tools/check-teams-growth-ui.py http://localhost:3000",
    "check:teams-friendly-ui": "python3 tools/check-teams-friendly-ui.py http://localhost:3000",
    "check:trends": "node tools/check-trends.js http://localhost:3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mongodb": "^6.10.0",
    "pdf-lib": "1.17.1"
  },
  "optionalDependencies": {
    "nodemailer": "6.9.16"
  }
}
