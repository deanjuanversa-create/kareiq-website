{
  "name": "kareiq-website",
  "version": "1.0.0",
  "private": true,
  "description": "KareIQ, Kare@Home, KareNest and KareWellness websites, the booking and enquiry API, and the KareIQ dashboard for families, nurses and the office",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:app": "node tools/check-app.js http://localhost:3000",
    "check:roles": "node tools/check-roles.js http://localhost:3000",
    "check:scheduler": "node tools/check-scheduler.js",
    "check:trends": "node tools/check-trends.js http://localhost:3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mongodb": "^6.10.0",
    "pdf-lib": "1.17.1"
  },
  "optionalDependencies": {
    "nodemailer": "6.9.16"
  }
}
